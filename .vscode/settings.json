{
  // %DIR% = carpeta del archivo raíz (.tex principal). Usarlo en vez de una
  // ruta fija hace que esto funcione sin importar qué carpeta abras en VS Code.
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.recipe.default": "latexmk",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.rootFile.doNotPrompt": true,
  // La receta manda siempre, aunque un .tex traiga "%!TEX TS-program".
  "latex-workshop.latex.build.forceRecipeUsage": true,
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-interaction=nonstopmode",
        "-synctex=1",
        "-file-line-error",
        "-outdir=%OUTDIR%",
        "-auxdir=%OUTDIR%",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    { "name": "latexmk", "tools": ["latexmk"] }
  ],
  "latex-workshop.view.pdf.viewer": "tab",
  "ltex": { "language": "es" }
}
